{
  "name": "hendy-app-store",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:user": "pnpm --filter @hendy/web-user dev",
    "dev:admin": "pnpm --filter @hendy/web-admin dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "cf:deploy:edge": "wrangler deploy --config workers/edge-router/wrangler.toml",
    "cf:deploy:api": "wrangler deploy --config workers/backend-api/wrangler.toml",
    "cf:deploy:ota": "wrangler deploy --config workers/ota-manifest-server/wrangler.toml",
    "cf:deploy:healing": "wrangler deploy --config workers/self-healing-bot/wrangler.toml",
    "cf:deploy:workers": "pnpm cf:deploy:edge && pnpm cf:deploy:api && pnpm cf:deploy:ota && pnpm cf:deploy:healing",
    "db:migrate:local": "wrangler d1 migrations apply hendy-appstore-db --local --config workers/backend-api/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply hendy-appstore-db --remote --config workers/backend-api/wrangler.toml",
    "test": "vitest run --passWithNoTests",
    "backup:d1": "node automation/db-backup.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "^22.19.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
